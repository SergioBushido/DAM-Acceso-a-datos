<?xml version="1.0"?>
<!DOCTYPE hibernate-configuration PUBLIC "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
                                         "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
 <session-factory>
  <!-- JDBC Database connection settings -->
  <property name="connection.driver_class">com.mysql.cj.jdbc.Driver</property>
  <property name="hibernate.connection.url">jdbc:mysql://148.113.202.164:3306/sefeji</property>
  <property name="hibernate.connection.username">sefeji</property>
  <property name="hibernate.connection.password">sefeji</property>

  <!-- Connection pool settings -->
  <property name="hibernate.connection.pool_size">5</property>

  <!-- Echo the SQL to stdout -->
  <property name="hibernate.show_sql">true</property>
  <property name="hibernate.format_sql">true</property>

  <!-- Set the current session context -->
  <property name="hibernate.current_session_context_class">thread</property>

  <!-- Schema generation -->
  <property name="hbm2ddl.auto">update</property>

  <!-- Mapping classes -->
  <mapping class="main.Vuelo"/>
  <mapping class="main.Pasajero"/>
 </session-factory>
</hibernate-configuration>
